{
  "name": "zoom-property-backend",
  "version": "1.0.0",
  "description": "API server for the Zoom Property real estate platform",
  "main": "dist/server.js",
  "author": "Zoom Property Development Team",
  "license": "MIT",
  "scripts": {
    "start": "node dist/server.js",
    "stop": "pkill -f 'node dist/server.js'",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "create-module": "npx ts-node src/scripts/createModule.ts",
    "seed:user": "ts-node src/app/db/seed.ts",
    "migrate:project-stages": "ts-node src/scripts/migrateProjectStages.ts",
    "migrate:serials": "ts-node src/scripts/resequenceSerials.ts",
    "seed:listings": "ts-node src/scripts/seedDemoListings.ts",
    "seed:amenities": "ts-node src/scripts/seedAmenities.ts",
    "seed:landowners": "ts-node src/scripts/seedLandownerBlocks.ts",
    "seed:blog": "ts-node src/scripts/seedBlog.ts",
    "seed:social": "ts-node src/scripts/seedSocialLinks.ts",
    "seed:reviews": "ts-node src/scripts/seedReviews.ts",
    "seed:projects": "ts-node src/scripts/seedProjects.ts",
    "seed:types": "ts-node src/scripts/seedPropertyTypes.ts",
    "seed:chrome": "ts-node src/scripts/seedSiteChrome.ts",
    "postman": "ts-node --transpile-only postman/generate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1080.0",
    "@types/node-cron": "^3.0.11",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "handlebars": "^4.7.8",
    "http-status-codes": "^2.3.0",
    "image-size": "^2.0.2",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "mongoose": "^8.9.5",
    "morgan": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^6.9.16",
    "sharp": "^0.35.3",
    "slugify": "^1.6.9",
    "socket.io": "^4.8.3",
    "ua-parser-js": "^2.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mime-types": "^2.1.4",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^6.4.17",
    "socket.io-client": "^4.8.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}